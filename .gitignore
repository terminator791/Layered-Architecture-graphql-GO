# Comprehensive .gitignore for Go Chat Application
# Based on https://github.com/github/gitignore/blob/main/Go.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
server
cli
main

# Test binary, built with `go test -c`
*.test
*.test.exe

# Output of the go coverage tool
*.out
coverage.*
*.coverprofile
profile.cov
coverage.html
coverage.txt

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Configuration files with sensitive data
config.json
config.yaml
config.yml
secrets.json

# Database files
*.db
*.sqlite
*.sqlite3

# Log files
*.log
logs/
log/

# Temporary files
tmp/
temp/
.tmp/

# Build artifacts
build/
dist/
bin/

# Editor/IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# JetBrains IDEs
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.dockerignore

# Node.js (for frontend development)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development tools
.air.toml
air_tmp/

# Documentation generation
docs/generated/
docs/build/

# Test databases
test.db
test_*.db

# Migration test files
migration_test_*.sql

# Generated GraphQL files (keep schema, ignore generated code)
internal/presentation/graphql/generated/

# Profiling output
*.prof
*.trace

# Go module cache (when developing locally)
go.sum.backup

# Air live reload tool
tmp/

# Local development certificates
*.pem
*.key
*.crt

# Local development scripts
dev.sh
local.sh
setup.sh

# Performance testing results
results/
benchmarks/

# Mock files generated by tools
*_mock.go
mocks/generated/

# Local database dumps
*.dump
*.sql.backup

# Redis dumps
dump.rdb

# Local Kubernetes configs
k8s-local/
local-k8s/

# Helm charts values files with secrets
values-local.yaml
values-dev.yaml
values-prod.yaml

# Docker compose override files
docker-compose.override.yml
docker-compose.local.yml

# Generated documentation
docs/api-docs/
docs/swagger/

# Local development data
data/
uploads/
attachments/

# Cache directories
.cache/
cache/

# Local SSL certificates
ssl/
certs/

# Development database backups
backups/
*.backup

# IDE workspace files
*.code-workspace

# Local configuration overrides
local.config.json
local.env

# Testing artifacts
test-results/
test-reports/

# Benchmark results
benchmark-*.txt
bench.out

# Memory profiles
mem.prof
cpu.prof
heap.prof

# Go fuzzing artifacts
testdata/fuzz/

# Local scripts
scripts/local/
local-scripts/
